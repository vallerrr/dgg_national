.DS_Store
**/.ipynb_checkpoints
**/__pycache__
.idea/
.Rproj.user
.Rhistory

# data/ and the generated outputs/ subdirs are symlinks into shared Dropbox
# (doc/decisions_shared.md D1)
/data/raw
/data/processed
/data/external
/outputs/results
/outputs/models
/outputs/graphs

# outputs/{fig,tables} are local, not committed: 82 MB of regenerable figures and
# date-stamped CSVs. The notebook that wrote each one is its folder name.
/outputs/fig
/outputs/tables

# machine-generated run logs (00_project_conventions.md §10: no README, not committed)
/logs/*
!/logs/.gitkeep

# quarto render artefacts
**/*_files/
**/figure-html/
**/libs/
*.html

# credentials — the real file never enters a commit (§7)
config/*.ini
!config/*.ini.example
/data
/doc
/doc
/doc
/data
